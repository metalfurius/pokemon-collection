{
  "name": "pokemon-collection",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "audit": "npm audit --omit=dev --audit-level=moderate",
    "check:policy": "node scripts/check-policy.mjs",
    "check": "npm run typecheck && npm run test:coverage && npm run audit && npm run check:policy && npm run build"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.7.2",
    "vite": "^6.1.0",
    "vitest": "^3.2.4"
  }
}
